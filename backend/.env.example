# MongoDB connection string. Leave it commented out during development to use
# a temporary in-memory database that is seeded with demo data on start-up.
# MONGO_URI=mongodb://127.0.0.1:27017/game-store

# Port for the API. GraphQL is served at /graphql and REST at /api.
PORT=5000

# Secret used to sign login tokens. Required when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API, or * for any.
CORS_ORIGIN=http://localhost:3000
